{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cert-transparency-watcher --json output (schema_version 1)",
  "type": "object",
  "required": ["schema_version", "tool", "version", "exit_code", "domain", "source", "days", "flagged", "new", "certs"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "tool": {"type": "string", "const": "cert-transparency-watcher"},
    "version": {"type": "string"},
    "exit_code": {"type": "integer", "enum": [0, 1]},
    "domain": {"type": "string"},
    "source": {"type": "string"},
    "days": {"type": "integer"},
    "flagged": {"type": "integer", "minimum": 0},
    "new": {"type": ["integer", "null"]},
    "certs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issued", "issuer", "names", "subdomains", "issuer_flagged", "unexpected_subdomains", "new", "flagged"],
        "properties": {
          "issued": {"type": ["string", "null"]},
          "issuer": {"type": "string"},
          "names": {"type": "array", "items": {"type": "string"}},
          "subdomains": {"type": "array", "items": {"type": "string"}},
          "issuer_flagged": {"type": "boolean"},
          "unexpected_subdomains": {"type": "array", "items": {"type": "string"}},
          "new": {"type": "boolean"},
          "flagged": {"type": "boolean"}
        }
      }
    }
  }
}
